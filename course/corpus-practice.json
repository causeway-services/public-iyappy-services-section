[
  {
    "e": "urn:561:lakota-corpus:ad67a8ae67b63268b7c3e3635070b986eb0c4ea1d800a5edcac6a6793cda1687:p21",
    "a": "http://www.w3.org/2004/02/skos/core#prefLabel",
    "v": {
      "kind": "literal",
      "value": "Itȟó iyápi waŋží onáȟ’uŋčhiyiŋ kta wačhíŋ na hé uŋ, wówapi čhič’ú weló.",
      "language": "lkt"
    },
    "t": "https://drive.google.com/file/d/1xmuGhcKes74mQIETrURfoRPcBiZdW-D9/view#sha256=ad67a8ae67b63268b7c3e3635070b986eb0c4ea1d800a5edcac6a6793cda1687;paragraph=21;profile=word-explicit-plain-break-italic"
  },
  {
    "e": "urn:561:lakota-corpus:ad67a8ae67b63268b7c3e3635070b986eb0c4ea1d800a5edcac6a6793cda1687:p21",
    "a": "http://www.w3.org/2004/02/skos/core#prefLabel",
    "v": {
      "kind": "literal",
      "value": "I suppose that I want to notify you, and for that reason, I’m writing you this letter.",
      "language": "en"
    },
    "t": "https://drive.google.com/file/d/1xmuGhcKes74mQIETrURfoRPcBiZdW-D9/view#sha256=ad67a8ae67b63268b7c3e3635070b986eb0c4ea1d800a5edcac6a6793cda1687;paragraph=21;profile=word-explicit-plain-break-italic"
  },
  {
    "e": "urn:561:lakota-corpus:ad67a8ae67b63268b7c3e3635070b986eb0c4ea1d800a5edcac6a6793cda1687:p22",
    "a": "http://www.w3.org/2004/02/skos/core#prefLabel",
    "v": {
      "kind": "literal",
      "value": "Táku waŋží awáčhaŋmi yuŋkȟáŋ hé uŋ, hepȟé ló.",
      "language": "lkt"
    },
    "t": "https://drive.google.com/file/d/1xmuGhcKes74mQIETrURfoRPcBiZdW-D9/view#sha256=ad67a8ae67b63268b7c3e3635070b986eb0c4ea1d800a5edcac6a6793cda1687;paragraph=22;profile=word-explicit-plain-break-italic"
  },
  {
    "e": "urn:561:lakota-corpus:ad67a8ae67b63268b7c3e3635070b986eb0c4ea1d800a5edcac6a6793cda1687:p22",
    "a": "http://www.w3.org/2004/02/skos/core#prefLabel",
    "v": {
      "kind": "literal",
      "value": "I have been thinking about something, and for that reason, I’m saying it.",
      "language": "en"
    },
    "t": "https://drive.google.com/file/d/1xmuGhcKes74mQIETrURfoRPcBiZdW-D9/view#sha256=ad67a8ae67b63268b7c3e3635070b986eb0c4ea1d800a5edcac6a6793cda1687;paragraph=22;profile=word-explicit-plain-break-italic"
  },
  {
    "e": "urn:561:lakota-corpus:ad67a8ae67b63268b7c3e3635070b986eb0c4ea1d800a5edcac6a6793cda1687:p23",
    "a": "http://www.w3.org/2004/02/skos/core#prefLabel",
    "v": {
      "kind": "literal",
      "value": "Hékta makȟá akáŋl wóopȟe kiŋ lé ičháǧe čiŋ héhaŋ, Wakȟáŋ Tȟáŋka oyáte kiŋ táku waŋží iwáhowičhaye k’uŋ hé weksúye.",
      "language": "lkt"
    },
    "t": "https://drive.google.com/file/d/1xmuGhcKes74mQIETrURfoRPcBiZdW-D9/view#sha256=ad67a8ae67b63268b7c3e3635070b986eb0c4ea1d800a5edcac6a6793cda1687;paragraph=23;profile=word-explicit-plain-break-italic"
  },
  {
    "e": "urn:561:lakota-corpus:ad67a8ae67b63268b7c3e3635070b986eb0c4ea1d800a5edcac6a6793cda1687:p23",
    "a": "http://www.w3.org/2004/02/skos/core#prefLabel",
    "v": {
      "kind": "literal",
      "value": "Back when customs were coming to being on earth, I remember that Creator warned the people about something.",
      "language": "en"
    },
    "t": "https://drive.google.com/file/d/1xmuGhcKes74mQIETrURfoRPcBiZdW-D9/view#sha256=ad67a8ae67b63268b7c3e3635070b986eb0c4ea1d800a5edcac6a6793cda1687;paragraph=23;profile=word-explicit-plain-break-italic"
  },
  {
    "e": "urn:561:lakota-corpus:ad67a8ae67b63268b7c3e3635070b986eb0c4ea1d800a5edcac6a6793cda1687:p24",
    "a": "http://www.w3.org/2004/02/skos/core#prefLabel",
    "v": {
      "kind": "literal",
      "value": "Yuŋkȟáŋ makȟá kiŋ huŋhúŋzahaŋ yuŋkȟáŋ, hé Wakȟáŋ Tȟáŋka oyáte makȟá akáŋl úŋpi kiŋ wičháyunini wahókuŋwičhakhiya seéčheča walá.",
      "language": "lkt"
    },
    "t": "https://drive.google.com/file/d/1xmuGhcKes74mQIETrURfoRPcBiZdW-D9/view#sha256=ad67a8ae67b63268b7c3e3635070b986eb0c4ea1d800a5edcac6a6793cda1687;paragraph=24;profile=word-explicit-plain-break-italic"
  },
  {
    "e": "urn:561:lakota-corpus:ad67a8ae67b63268b7c3e3635070b986eb0c4ea1d800a5edcac6a6793cda1687:p24",
    "a": "http://www.w3.org/2004/02/skos/core#prefLabel",
    "v": {
      "kind": "literal",
      "value": "And so there was an earthquake, and so I ask that Creator do something like warning the people that live on the earth by nudging them.",
      "language": "en"
    },
    "t": "https://drive.google.com/file/d/1xmuGhcKes74mQIETrURfoRPcBiZdW-D9/view#sha256=ad67a8ae67b63268b7c3e3635070b986eb0c4ea1d800a5edcac6a6793cda1687;paragraph=24;profile=word-explicit-plain-break-italic"
  },
  {
    "e": "urn:561:lakota-corpus:ad67a8ae67b63268b7c3e3635070b986eb0c4ea1d800a5edcac6a6793cda1687:p25",
    "a": "http://www.w3.org/2004/02/skos/core#prefLabel",
    "v": {
      "kind": "literal",
      "value": "Nakúŋ wičháȟpi waŋžígži tȟókeča waŋúŋyaŋkapi yuŋkȟáŋ, hé nakúŋ waŋží walá.",
      "language": "lkt"
    },
    "t": "https://drive.google.com/file/d/1xmuGhcKes74mQIETrURfoRPcBiZdW-D9/view#sha256=ad67a8ae67b63268b7c3e3635070b986eb0c4ea1d800a5edcac6a6793cda1687;paragraph=25;profile=word-explicit-plain-break-italic"
  },
  {
    "e": "urn:561:lakota-corpus:ad67a8ae67b63268b7c3e3635070b986eb0c4ea1d800a5edcac6a6793cda1687:p25",
    "a": "http://www.w3.org/2004/02/skos/core#prefLabel",
    "v": {
      "kind": "literal",
      "value": "We also saw some strange stars, and so I asked for that.",
      "language": "en"
    },
    "t": "https://drive.google.com/file/d/1xmuGhcKes74mQIETrURfoRPcBiZdW-D9/view#sha256=ad67a8ae67b63268b7c3e3635070b986eb0c4ea1d800a5edcac6a6793cda1687;paragraph=25;profile=word-explicit-plain-break-italic"
  },
  {
    "e": "urn:561:lakota-corpus:ad67a8ae67b63268b7c3e3635070b986eb0c4ea1d800a5edcac6a6793cda1687:p26",
    "a": "http://www.w3.org/2004/02/skos/core#prefLabel",
    "v": {
      "kind": "literal",
      "value": "Nakúŋ tȟaté waŋžígži theȟíka waŋúŋyaŋkapi yuŋkȟáŋ, hé nakúŋ waŋží walá.",
      "language": "lkt"
    },
    "t": "https://drive.google.com/file/d/1xmuGhcKes74mQIETrURfoRPcBiZdW-D9/view#sha256=ad67a8ae67b63268b7c3e3635070b986eb0c4ea1d800a5edcac6a6793cda1687;paragraph=26;profile=word-explicit-plain-break-italic"
  },
  {
    "e": "urn:561:lakota-corpus:ad67a8ae67b63268b7c3e3635070b986eb0c4ea1d800a5edcac6a6793cda1687:p26",
    "a": "http://www.w3.org/2004/02/skos/core#prefLabel",
    "v": {
      "kind": "literal",
      "value": "We also saw some really bad wind, and so I asked for that.",
      "language": "en"
    },
    "t": "https://drive.google.com/file/d/1xmuGhcKes74mQIETrURfoRPcBiZdW-D9/view#sha256=ad67a8ae67b63268b7c3e3635070b986eb0c4ea1d800a5edcac6a6793cda1687;paragraph=26;profile=word-explicit-plain-break-italic"
  },
  {
    "e": "urn:561:lakota-corpus:ad67a8ae67b63268b7c3e3635070b986eb0c4ea1d800a5edcac6a6793cda1687:p27",
    "a": "http://www.w3.org/2004/02/skos/core#prefLabel",
    "v": {
      "kind": "literal",
      "value": "Héhaŋ nakúŋ makȟá kiŋ blebléčahaŋ čhaŋkhé, leháŋn mayá óta yuŋkȟáŋ, nakúŋ hé waŋží walá.",
      "language": "lkt"
    },
    "t": "https://drive.google.com/file/d/1xmuGhcKes74mQIETrURfoRPcBiZdW-D9/view#sha256=ad67a8ae67b63268b7c3e3635070b986eb0c4ea1d800a5edcac6a6793cda1687;paragraph=27;profile=word-explicit-plain-break-italic"
  },
  {
    "e": "urn:561:lakota-corpus:ad67a8ae67b63268b7c3e3635070b986eb0c4ea1d800a5edcac6a6793cda1687:p27",
    "a": "http://www.w3.org/2004/02/skos/core#prefLabel",
    "v": {
      "kind": "literal",
      "value": "Back then the earth also cracked open, and so nowadays there are many cliffs, and so I asked for that.",
      "language": "en"
    },
    "t": "https://drive.google.com/file/d/1xmuGhcKes74mQIETrURfoRPcBiZdW-D9/view#sha256=ad67a8ae67b63268b7c3e3635070b986eb0c4ea1d800a5edcac6a6793cda1687;paragraph=27;profile=word-explicit-plain-break-italic"
  },
  {
    "e": "urn:561:lakota-corpus:ad67a8ae67b63268b7c3e3635070b986eb0c4ea1d800a5edcac6a6793cda1687:p28",
    "a": "http://www.w3.org/2004/02/skos/core#prefLabel",
    "v": {
      "kind": "literal",
      "value": "Héhaŋ wičháša kiŋ óta oyáte tȟókeča iyápi, hé nakúŋ waŋží walá.",
      "language": "lkt"
    },
    "t": "https://drive.google.com/file/d/1xmuGhcKes74mQIETrURfoRPcBiZdW-D9/view#sha256=ad67a8ae67b63268b7c3e3635070b986eb0c4ea1d800a5edcac6a6793cda1687;paragraph=28;profile=word-explicit-plain-break-italic"
  },
  {
    "e": "urn:561:lakota-corpus:ad67a8ae67b63268b7c3e3635070b986eb0c4ea1d800a5edcac6a6793cda1687:p28",
    "a": "http://www.w3.org/2004/02/skos/core#prefLabel",
    "v": {
      "kind": "literal",
      "value": "Back then many people spoke a different language, I also asked for that.",
      "language": "en"
    },
    "t": "https://drive.google.com/file/d/1xmuGhcKes74mQIETrURfoRPcBiZdW-D9/view#sha256=ad67a8ae67b63268b7c3e3635070b986eb0c4ea1d800a5edcac6a6793cda1687;paragraph=28;profile=word-explicit-plain-break-italic"
  },
  {
    "e": "urn:561:lakota-corpus:ad67a8ae67b63268b7c3e3635070b986eb0c4ea1d800a5edcac6a6793cda1687:p29",
    "a": "http://www.w3.org/2004/02/skos/core#prefLabel",
    "v": {
      "kind": "literal",
      "value": "Héhaŋ nakúŋ leháŋn wíŋyaŋ kiŋ tuwéna zaŋníyaŋ čhiŋčátȟuŋ šni yuŋkȟáŋ, hé nakúŋ waŋží walá.",
      "language": "lkt"
    },
    "t": "https://drive.google.com/file/d/1xmuGhcKes74mQIETrURfoRPcBiZdW-D9/view#sha256=ad67a8ae67b63268b7c3e3635070b986eb0c4ea1d800a5edcac6a6793cda1687;paragraph=29;profile=word-explicit-plain-break-italic"
  },
  {
    "e": "urn:561:lakota-corpus:ad67a8ae67b63268b7c3e3635070b986eb0c4ea1d800a5edcac6a6793cda1687:p29",
    "a": "http://www.w3.org/2004/02/skos/core#prefLabel",
    "v": {
      "kind": "literal",
      "value": "Back then no women were also healthy in childbirth, and so I also asked for that.",
      "language": "en"
    },
    "t": "https://drive.google.com/file/d/1xmuGhcKes74mQIETrURfoRPcBiZdW-D9/view#sha256=ad67a8ae67b63268b7c3e3635070b986eb0c4ea1d800a5edcac6a6793cda1687;paragraph=29;profile=word-explicit-plain-break-italic"
  },
  {
    "e": "urn:561:lakota-corpus:ad67a8ae67b63268b7c3e3635070b986eb0c4ea1d800a5edcac6a6793cda1687:p30",
    "a": "http://www.w3.org/2004/02/skos/core#prefLabel",
    "v": {
      "kind": "literal",
      "value": "Yuŋkȟáŋ hé uŋ, mitákuyepi, wówapi kiŋ lé tóna waŋlákapi kiŋ, nitákuyepi tóna wóopȟe awáčhiŋ šni kiŋ hená, Wakȟáŋ Tȟáŋka wičháša wičháyunini wahókuŋwičhakhiya seéčheča.",
      "language": "lkt"
    },
    "t": "https://drive.google.com/file/d/1xmuGhcKes74mQIETrURfoRPcBiZdW-D9/view#sha256=ad67a8ae67b63268b7c3e3635070b986eb0c4ea1d800a5edcac6a6793cda1687;paragraph=30;profile=word-explicit-plain-break-italic"
  },
  {
    "e": "urn:561:lakota-corpus:ad67a8ae67b63268b7c3e3635070b986eb0c4ea1d800a5edcac6a6793cda1687:p30",
    "a": "http://www.w3.org/2004/02/skos/core#prefLabel",
    "v": {
      "kind": "literal",
      "value": "And so for that reason, my relatives, those of you who see this letter, those relatives of yours who aren’t paying attention to the laws, it’s like Creator is warning them through nudging them.",
      "language": "en"
    },
    "t": "https://drive.google.com/file/d/1xmuGhcKes74mQIETrURfoRPcBiZdW-D9/view#sha256=ad67a8ae67b63268b7c3e3635070b986eb0c4ea1d800a5edcac6a6793cda1687;paragraph=30;profile=word-explicit-plain-break-italic"
  },
  {
    "e": "urn:561:lakota-corpus:ad67a8ae67b63268b7c3e3635070b986eb0c4ea1d800a5edcac6a6793cda1687:p31",
    "a": "http://www.w3.org/2004/02/skos/core#prefLabel",
    "v": {
      "kind": "literal",
      "value": "Hé iyéčhel nitákuyepi kiŋ wóopȟe kiŋ líla ečhúŋwičhakhiyapi iyéčheča walá.",
      "language": "lkt"
    },
    "t": "https://drive.google.com/file/d/1xmuGhcKes74mQIETrURfoRPcBiZdW-D9/view#sha256=ad67a8ae67b63268b7c3e3635070b986eb0c4ea1d800a5edcac6a6793cda1687;paragraph=31;profile=word-explicit-plain-break-italic"
  },
  {
    "e": "urn:561:lakota-corpus:ad67a8ae67b63268b7c3e3635070b986eb0c4ea1d800a5edcac6a6793cda1687:p31",
    "a": "http://www.w3.org/2004/02/skos/core#prefLabel",
    "v": {
      "kind": "literal",
      "value": "For that reason I request that they really should let your relatives follow the rules.",
      "language": "en"
    },
    "t": "https://drive.google.com/file/d/1xmuGhcKes74mQIETrURfoRPcBiZdW-D9/view#sha256=ad67a8ae67b63268b7c3e3635070b986eb0c4ea1d800a5edcac6a6793cda1687;paragraph=31;profile=word-explicit-plain-break-italic"
  },
  {
    "e": "urn:561:lakota-corpus:ad67a8ae67b63268b7c3e3635070b986eb0c4ea1d800a5edcac6a6793cda1687:p32",
    "a": "http://www.w3.org/2004/02/skos/core#prefLabel",
    "v": {
      "kind": "literal",
      "value": "Waŋná makȟá akáŋl wičhóičhaǧe kiŋ khiyéla seéčheča walá.",
      "language": "lkt"
    },
    "t": "https://drive.google.com/file/d/1xmuGhcKes74mQIETrURfoRPcBiZdW-D9/view#sha256=ad67a8ae67b63268b7c3e3635070b986eb0c4ea1d800a5edcac6a6793cda1687;paragraph=32;profile=word-explicit-plain-break-italic"
  },
  {
    "e": "urn:561:lakota-corpus:ad67a8ae67b63268b7c3e3635070b986eb0c4ea1d800a5edcac6a6793cda1687:p32",
    "a": "http://www.w3.org/2004/02/skos/core#prefLabel",
    "v": {
      "kind": "literal",
      "value": "Then I request that the people living on be close.",
      "language": "en"
    },
    "t": "https://drive.google.com/file/d/1xmuGhcKes74mQIETrURfoRPcBiZdW-D9/view#sha256=ad67a8ae67b63268b7c3e3635070b986eb0c4ea1d800a5edcac6a6793cda1687;paragraph=32;profile=word-explicit-plain-break-italic"
  },
  {
    "e": "urn:561:lakota-corpus:ad67a8ae67b63268b7c3e3635070b986eb0c4ea1d800a5edcac6a6793cda1687:p33",
    "a": "http://www.w3.org/2004/02/skos/core#prefLabel",
    "v": {
      "kind": "literal",
      "value": "Na hé uŋ hepȟé ló.",
      "language": "lkt"
    },
    "t": "https://drive.google.com/file/d/1xmuGhcKes74mQIETrURfoRPcBiZdW-D9/view#sha256=ad67a8ae67b63268b7c3e3635070b986eb0c4ea1d800a5edcac6a6793cda1687;paragraph=33;profile=word-explicit-plain-break-italic"
  },
  {
    "e": "urn:561:lakota-corpus:ad67a8ae67b63268b7c3e3635070b986eb0c4ea1d800a5edcac6a6793cda1687:p33",
    "a": "http://www.w3.org/2004/02/skos/core#prefLabel",
    "v": {
      "kind": "literal",
      "value": "And for that reason I say that.",
      "language": "en"
    },
    "t": "https://drive.google.com/file/d/1xmuGhcKes74mQIETrURfoRPcBiZdW-D9/view#sha256=ad67a8ae67b63268b7c3e3635070b986eb0c4ea1d800a5edcac6a6793cda1687;paragraph=33;profile=word-explicit-plain-break-italic"
  },
  {
    "e": "urn:561:lakota-corpus:ad67a8ae67b63268b7c3e3635070b986eb0c4ea1d800a5edcac6a6793cda1687:p35",
    "a": "http://www.w3.org/2004/02/skos/core#prefLabel",
    "v": {
      "kind": "literal",
      "value": "Wild West Oškáte kiŋ",
      "language": "lkt"
    },
    "t": "https://drive.google.com/file/d/1xmuGhcKes74mQIETrURfoRPcBiZdW-D9/view#sha256=ad67a8ae67b63268b7c3e3635070b986eb0c4ea1d800a5edcac6a6793cda1687;paragraph=35;profile=word-explicit-plain-break-italic"
  },
  {
    "e": "urn:561:lakota-corpus:ad67a8ae67b63268b7c3e3635070b986eb0c4ea1d800a5edcac6a6793cda1687:p35",
    "a": "http://www.w3.org/2004/02/skos/core#prefLabel",
    "v": {
      "kind": "literal",
      "value": "The Wild West Show",
      "language": "en"
    },
    "t": "https://drive.google.com/file/d/1xmuGhcKes74mQIETrURfoRPcBiZdW-D9/view#sha256=ad67a8ae67b63268b7c3e3635070b986eb0c4ea1d800a5edcac6a6793cda1687;paragraph=35;profile=word-explicit-plain-break-italic"
  },
  {
    "e": "urn:561:lakota-corpus:ad67a8ae67b63268b7c3e3635070b986eb0c4ea1d800a5edcac6a6793cda1687:p37",
    "a": "http://www.w3.org/2004/02/skos/core#prefLabel",
    "v": {
      "kind": "literal",
      "value": "Wild West oškáte kiŋ lé él tókhel waúŋ kiŋ leháŋl owáglakiŋ kte ló.",
      "language": "lkt"
    },
    "t": "https://drive.google.com/file/d/1xmuGhcKes74mQIETrURfoRPcBiZdW-D9/view#sha256=ad67a8ae67b63268b7c3e3635070b986eb0c4ea1d800a5edcac6a6793cda1687;paragraph=37;profile=word-explicit-plain-break-italic"
  },
  {
    "e": "urn:561:lakota-corpus:ad67a8ae67b63268b7c3e3635070b986eb0c4ea1d800a5edcac6a6793cda1687:p37",
    "a": "http://www.w3.org/2004/02/skos/core#prefLabel",
    "v": {
      "kind": "literal",
      "value": "I’ll tell you about how I was part of this Wild West show.",
      "language": "en"
    },
    "t": "https://drive.google.com/file/d/1xmuGhcKes74mQIETrURfoRPcBiZdW-D9/view#sha256=ad67a8ae67b63268b7c3e3635070b986eb0c4ea1d800a5edcac6a6793cda1687;paragraph=37;profile=word-explicit-plain-break-italic"
  },
  {
    "e": "urn:561:lakota-corpus:ad67a8ae67b63268b7c3e3635070b986eb0c4ea1d800a5edcac6a6793cda1687:p38",
    "a": "http://www.w3.org/2004/02/skos/core#prefLabel",
    "v": {
      "kind": "literal",
      "value": "Mitȟáwačhiŋ úŋ óhiŋniyaŋ wóopȟe bluhá na óhiŋniyaŋ Wakȟáŋ Tȟáŋka kiksúya waúŋ.",
      "language": "lkt"
    },
    "t": "https://drive.google.com/file/d/1xmuGhcKes74mQIETrURfoRPcBiZdW-D9/view#sha256=ad67a8ae67b63268b7c3e3635070b986eb0c4ea1d800a5edcac6a6793cda1687;paragraph=38;profile=word-explicit-plain-break-italic"
  },
  {
    "e": "urn:561:lakota-corpus:ad67a8ae67b63268b7c3e3635070b986eb0c4ea1d800a5edcac6a6793cda1687:p38",
    "a": "http://www.w3.org/2004/02/skos/core#prefLabel",
    "v": {
      "kind": "literal",
      "value": "I always have the customs in mind and I always remember back to Creator.",
      "language": "en"
    },
    "t": "https://drive.google.com/file/d/1xmuGhcKes74mQIETrURfoRPcBiZdW-D9/view#sha256=ad67a8ae67b63268b7c3e3635070b986eb0c4ea1d800a5edcac6a6793cda1687;paragraph=38;profile=word-explicit-plain-break-italic"
  },
  {
    "e": "urn:561:lakota-corpus:ad67a8ae67b63268b7c3e3635070b986eb0c4ea1d800a5edcac6a6793cda1687:p39",
    "a": "http://www.w3.org/2004/02/skos/core#prefLabel",
    "v": {
      "kind": "literal",
      "value": "Tkȟá oškáte kiŋ aŋpétu na haŋhépi kȟó íŋyaŋke čhaŋkhé, mázaškaŋškaŋ óapȟe núŋpa heháŋyela owáŋžila uŋyáŋkapi.",
      "language": "lkt"
    },
    "t": "https://drive.google.com/file/d/1xmuGhcKes74mQIETrURfoRPcBiZdW-D9/view#sha256=ad67a8ae67b63268b7c3e3635070b986eb0c4ea1d800a5edcac6a6793cda1687;paragraph=39;profile=word-explicit-plain-break-italic"
  },
  {
    "e": "urn:561:lakota-corpus:ad67a8ae67b63268b7c3e3635070b986eb0c4ea1d800a5edcac6a6793cda1687:p39",
    "a": "http://www.w3.org/2004/02/skos/core#prefLabel",
    "v": {
      "kind": "literal",
      "value": "But the show runs day and night, so we’re up until two in the morning.",
      "language": "en"
    },
    "t": "https://drive.google.com/file/d/1xmuGhcKes74mQIETrURfoRPcBiZdW-D9/view#sha256=ad67a8ae67b63268b7c3e3635070b986eb0c4ea1d800a5edcac6a6793cda1687;paragraph=39;profile=word-explicit-plain-break-italic"
  },
  {
    "e": "urn:561:lakota-corpus:ad67a8ae67b63268b7c3e3635070b986eb0c4ea1d800a5edcac6a6793cda1687:p40",
    "a": "http://www.w3.org/2004/02/skos/core#prefLabel",
    "v": {
      "kind": "literal",
      "value": "Tkȟá óhiŋniyaŋ Wakȟáŋ Tȟáŋka kiksúya waúŋ kiŋ héčhel táku oyás’iŋ okíhi-makhiye ló.",
      "language": "lkt"
    },
    "t": "https://drive.google.com/file/d/1xmuGhcKes74mQIETrURfoRPcBiZdW-D9/view#sha256=ad67a8ae67b63268b7c3e3635070b986eb0c4ea1d800a5edcac6a6793cda1687;paragraph=40;profile=word-explicit-plain-break-italic"
  },
  {
    "e": "urn:561:lakota-corpus:ad67a8ae67b63268b7c3e3635070b986eb0c4ea1d800a5edcac6a6793cda1687:p40",
    "a": "http://www.w3.org/2004/02/skos/core#prefLabel",
    "v": {
      "kind": "literal",
      "value": "But always remembering back to Creator lets me be able to do everything that needs to be done.",
      "language": "en"
    },
    "t": "https://drive.google.com/file/d/1xmuGhcKes74mQIETrURfoRPcBiZdW-D9/view#sha256=ad67a8ae67b63268b7c3e3635070b986eb0c4ea1d800a5edcac6a6793cda1687;paragraph=40;profile=word-explicit-plain-break-italic"
  },
  {
    "e": "urn:561:lakota-corpus:ad67a8ae67b63268b7c3e3635070b986eb0c4ea1d800a5edcac6a6793cda1687:p41",
    "a": "http://www.w3.org/2004/02/skos/core#prefLabel",
    "v": {
      "kind": "literal",
      "value": "Hó po, Mitákuye Lakȟóta oyáte kiŋ, leháŋl wašíču tȟawíčhoȟ’aŋ kiŋ táŋyaŋ slolwáye ló.",
      "language": "lkt"
    },
    "t": "https://drive.google.com/file/d/1xmuGhcKes74mQIETrURfoRPcBiZdW-D9/view#sha256=ad67a8ae67b63268b7c3e3635070b986eb0c4ea1d800a5edcac6a6793cda1687;paragraph=41;profile=word-explicit-plain-break-italic"
  },
  {
    "e": "urn:561:lakota-corpus:ad67a8ae67b63268b7c3e3635070b986eb0c4ea1d800a5edcac6a6793cda1687:p41",
    "a": "http://www.w3.org/2004/02/skos/core#prefLabel",
    "v": {
      "kind": "literal",
      "value": "Now, my Lakota relatives, I know white people’s way of doing things very well these days.",
      "language": "en"
    },
    "t": "https://drive.google.com/file/d/1xmuGhcKes74mQIETrURfoRPcBiZdW-D9/view#sha256=ad67a8ae67b63268b7c3e3635070b986eb0c4ea1d800a5edcac6a6793cda1687;paragraph=41;profile=word-explicit-plain-break-italic"
  },
  {
    "e": "urn:561:lakota-corpus:ad67a8ae67b63268b7c3e3635070b986eb0c4ea1d800a5edcac6a6793cda1687:p42",
    "a": "http://www.w3.org/2004/02/skos/core#prefLabel",
    "v": {
      "kind": "literal",
      "value": "Tuwá Wakȟáŋ Tȟáŋka awáčhiŋ kiŋ táku wičhóȟ’aŋ wašté iyéyiŋ kte ló, hé wakȟé ló.",
      "language": "lkt"
    },
    "t": "https://drive.google.com/file/d/1xmuGhcKes74mQIETrURfoRPcBiZdW-D9/view#sha256=ad67a8ae67b63268b7c3e3635070b986eb0c4ea1d800a5edcac6a6793cda1687;paragraph=42;profile=word-explicit-plain-break-italic"
  },
  {
    "e": "urn:561:lakota-corpus:ad67a8ae67b63268b7c3e3635070b986eb0c4ea1d800a5edcac6a6793cda1687:p42",
    "a": "http://www.w3.org/2004/02/skos/core#prefLabel",
    "v": {
      "kind": "literal",
      "value": "If someone always has Creator in mind, their ways of doing things are good, that’s what I mean.",
      "language": "en"
    },
    "t": "https://drive.google.com/file/d/1xmuGhcKes74mQIETrURfoRPcBiZdW-D9/view#sha256=ad67a8ae67b63268b7c3e3635070b986eb0c4ea1d800a5edcac6a6793cda1687;paragraph=42;profile=word-explicit-plain-break-italic"
  },
  {
    "e": "urn:561:lakota-corpus:ad67a8ae67b63268b7c3e3635070b986eb0c4ea1d800a5edcac6a6793cda1687:p43",
    "a": "http://www.w3.org/2004/02/skos/core#prefLabel",
    "v": {
      "kind": "literal",
      "value": "Na táku wičhóȟ’aŋ wašíču ečhúŋpi kiŋ óta theȟíke ló.",
      "language": "lkt"
    },
    "t": "https://drive.google.com/file/d/1xmuGhcKes74mQIETrURfoRPcBiZdW-D9/view#sha256=ad67a8ae67b63268b7c3e3635070b986eb0c4ea1d800a5edcac6a6793cda1687;paragraph=43;profile=word-explicit-plain-break-italic"
  },
  {
    "e": "urn:561:lakota-corpus:ad67a8ae67b63268b7c3e3635070b986eb0c4ea1d800a5edcac6a6793cda1687:p43",
    "a": "http://www.w3.org/2004/02/skos/core#prefLabel",
    "v": {
      "kind": "literal",
      "value": "And a lot of the white people’s way of doing things are awful.",
      "language": "en"
    },
    "t": "https://drive.google.com/file/d/1xmuGhcKes74mQIETrURfoRPcBiZdW-D9/view#sha256=ad67a8ae67b63268b7c3e3635070b986eb0c4ea1d800a5edcac6a6793cda1687;paragraph=43;profile=word-explicit-plain-break-italic"
  },
  {
    "e": "urn:561:lakota-corpus:ad67a8ae67b63268b7c3e3635070b986eb0c4ea1d800a5edcac6a6793cda1687:p44",
    "a": "http://www.w3.org/2004/02/skos/core#prefLabel",
    "v": {
      "kind": "literal",
      "value": "Tuwá makȟóčhe ničá hená thiwókhitȟahena t’é ló.",
      "language": "lkt"
    },
    "t": "https://drive.google.com/file/d/1xmuGhcKes74mQIETrURfoRPcBiZdW-D9/view#sha256=ad67a8ae67b63268b7c3e3635070b986eb0c4ea1d800a5edcac6a6793cda1687;paragraph=44;profile=word-explicit-plain-break-italic"
  },
  {
    "e": "urn:561:lakota-corpus:ad67a8ae67b63268b7c3e3635070b986eb0c4ea1d800a5edcac6a6793cda1687:p44",
    "a": "http://www.w3.org/2004/02/skos/core#prefLabel",
    "v": {
      "kind": "literal",
      "value": "Somebody who doesn’t have any land dies between the houses.",
      "language": "en"
    },
    "t": "https://drive.google.com/file/d/1xmuGhcKes74mQIETrURfoRPcBiZdW-D9/view#sha256=ad67a8ae67b63268b7c3e3635070b986eb0c4ea1d800a5edcac6a6793cda1687;paragraph=44;profile=word-explicit-plain-break-italic"
  },
  {
    "e": "urn:561:lakota-corpus:ad67a8ae67b63268b7c3e3635070b986eb0c4ea1d800a5edcac6a6793cda1687:p45",
    "a": "http://www.w3.org/2004/02/skos/core#prefLabel",
    "v": {
      "kind": "literal",
      "value": "Na makȟóčhe kiŋ otȟáŋkaya k’éyaš óhiŋniyaŋ wašíču ožúlaye ló.",
      "language": "lkt"
    },
    "t": "https://drive.google.com/file/d/1xmuGhcKes74mQIETrURfoRPcBiZdW-D9/view#sha256=ad67a8ae67b63268b7c3e3635070b986eb0c4ea1d800a5edcac6a6793cda1687;paragraph=45;profile=word-explicit-plain-break-italic"
  },
  {
    "e": "urn:561:lakota-corpus:ad67a8ae67b63268b7c3e3635070b986eb0c4ea1d800a5edcac6a6793cda1687:p45",
    "a": "http://www.w3.org/2004/02/skos/core#prefLabel",
    "v": {
      "kind": "literal",
      "value": "And the land is expansive, but it is filled with white men.",
      "language": "en"
    },
    "t": "https://drive.google.com/file/d/1xmuGhcKes74mQIETrURfoRPcBiZdW-D9/view#sha256=ad67a8ae67b63268b7c3e3635070b986eb0c4ea1d800a5edcac6a6793cda1687;paragraph=45;profile=word-explicit-plain-break-italic"
  },
  {
    "e": "urn:561:lakota-corpus:ad67a8ae67b63268b7c3e3635070b986eb0c4ea1d800a5edcac6a6793cda1687:p46",
    "a": "http://www.w3.org/2004/02/skos/core#prefLabel",
    "v": {
      "kind": "literal",
      "value": "Heháŋl makȟá óhiŋni táku ičháŋtewašteya waúŋ weló.",
      "language": "lkt"
    },
    "t": "https://drive.google.com/file/d/1xmuGhcKes74mQIETrURfoRPcBiZdW-D9/view#sha256=ad67a8ae67b63268b7c3e3635070b986eb0c4ea1d800a5edcac6a6793cda1687;paragraph=46;profile=word-explicit-plain-break-italic"
  },
  {
    "e": "urn:561:lakota-corpus:ad67a8ae67b63268b7c3e3635070b986eb0c4ea1d800a5edcac6a6793cda1687:p46",
    "a": "http://www.w3.org/2004/02/skos/core#prefLabel",
    "v": {
      "kind": "literal",
      "value": "Then I always live happily because of the land.",
      "language": "en"
    },
    "t": "https://drive.google.com/file/d/1xmuGhcKes74mQIETrURfoRPcBiZdW-D9/view#sha256=ad67a8ae67b63268b7c3e3635070b986eb0c4ea1d800a5edcac6a6793cda1687;paragraph=46;profile=word-explicit-plain-break-italic"
  }
]
